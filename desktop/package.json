{
  "name": "open-dots-desktop",
  "version": "0.8.4",
  "private": true,
  "description": "Chief of Noumenon desktop app: an Electron window around the local backend. Runs from a source checkout or installed.",
  "main": "main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "app": "node scripts/run.js",
    "setup": "node scripts/setup.js",
    "build": "node scripts/build.js",
    "start": "node scripts/launch.js start",
    "dev": "node scripts/launch.js dev",
    "doctor": "node scripts/doctor.js",
    "test": "node --test \"test/*.test.js\"",
    "e2e": "node e2e/run.js",
    "e2e:smoke": "node e2e/source-smoke.js",
    "e2e:ui": "playwright test",
    "e2e:ui:real": "node playwright/run-real.js",
    "package": "node scripts/package.js",
    "smoke:packaged": "node scripts/smoke-packaged.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.15.3"
  },
  "author": "Open Duet authors and Chief of Noumenon contributors",
  "build": {
    "appId": "app.opendots.desktop",
    "productName": "Chief of Noumenon",
    "executableName": "Chief of Noumenon",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/open-dots-backend",
        "to": "backend"
      },
      {
        "from": "../frontend/out",
        "to": "ui"
      }
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Chief-of-Noumenon-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "Chief-of-Noumenon-${version}-arm64.${ext}"
    }
  }
}
